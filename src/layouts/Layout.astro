---
import Navbar from "@/components/Navbar";
import Footer from "@/components/Footer";
import { BackToTop } from "@/components/BackToTop";
import { VERSION } from "@/version";
import "@/styles/global.css";
import { canonicalPageURL } from "@/lib/seo";
import { getRelativeLocaleUrl } from "astro:i18n";
import { ui } from "@/i18n/ui";
import { locales, isLocale, localeFromPath, unlocalizedPath, translatedPages, languageNames, languageTags, ogLocales, type Locale } from "@/i18n/config";
interface Props {
  locale?: Locale;
  alternates?: { locale: Locale; href: string }[];
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
}

const locale = Astro.props.locale ?? (isLocale(Astro.currentLocale) ? Astro.currentLocale : localeFromPath(Astro.url.pathname));
const t = ui[locale];
const path = unlocalizedPath(Astro.url.pathname).replace(/\/$/, "") || "/";
const alternates = Astro.props.alternates ?? (translatedPages.includes(path)
  ? locales.map((language) => ({ locale: language, href: getRelativeLocaleUrl(language, path.replace(/^\//, "")) }))
  : [{ locale, href: Astro.url.pathname }]);
const defaultAlternate = alternates.find((alternate) => alternate.locale === "en");
const languages = locales.map((language) => {
  const alternate = alternates.find((entry) => entry.locale === language);
  return { locale: language, href: alternate?.href ?? getRelativeLocaleUrl(language, ""), label: languageNames[language] + (alternate ? "" : ` · ${ui[language].languageHome}`) };
});

const {
  title = t.siteTitle,
  description = t.siteDescription,
  image = "/og-image.png",
  canonicalURL,
  ogType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageURL = canonicalPageURL(canonicalURL ?? Astro.url.pathname, Astro.site);

// Get version info from build-time generated file
const { commitHash, buildDate } = VERSION;

// Safer URL construction with fallback
const ogImageUrl = image.startsWith("http")
  ? image
  : new URL(image, Astro.site || "https://heyjoseph.me").toString();

// Format the title
const siteTitle = title.includes("Joseph") ? title : `${title} | Joseph`;
---

<!doctype html>
<html lang={languageTags[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Favicon */}
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    {/* Basic SEO */}
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageURL} />

    {alternates.map((alternate) => <link rel="alternate" hreflang={languageTags[alternate.locale]} href={canonicalPageURL(alternate.href, Astro.site)} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={canonicalPageURL(defaultAlternate.href, Astro.site)} />}

    {/* Open Graph / Facebook */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Joseph Ju" />
    <meta property="og:locale" content={ogLocales[locale]} />

    {ogType === "article" && (
      <>
        {publishedTime && <meta property="article:published_time" content={publishedTime} />}
        {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
        <meta property="article:author" content={new URL(getRelativeLocaleUrl(locale, "about/"), Astro.site).href} />
      </>
    )}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="heyjoseph.me" />
    <meta property="twitter:url" content={pageURL} />
    <meta name="twitter:site" content="@heyjosephme" />
    <meta name="twitter:creator" content="@heyjosephme" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Additional Meta */}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />

    {/* RSS Feed */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t.blog} — Joseph`}
      href={new URL(getRelativeLocaleUrl(locale, "rss.xml"), Astro.site).href}
    />

    {/* Theme initialization script - prevents flash on page load */}
    <script is:inline>
      (function () {
        const getThemePreference = () => {
          const stored = localStorage.getItem("theme");
          if (stored) return stored;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        };

        const theme = getThemePreference();
        document.documentElement.classList.toggle("dark", theme === "dark");
      })();
    </script>
  </head>
  <body>
    <div class="flex min-h-screen flex-col bg-background">
      <Navbar locale={locale} languages={languages} client:load />
      <main class="flex-1">
        <slot />
      </main>
      <Footer locale={locale} commitHash={commitHash} buildDate={buildDate} client:load />
      <BackToTop locale={locale} client:load />
    </div>
  </body>
</html>

<style is:global>
  /* Add any global styles here */
  html,
  body {
    height: 100%;
  }
</style>
