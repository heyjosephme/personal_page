---
import TagDetail from "@/views/TagDetail.astro";
import { localizedPosts } from "@/i18n/content";
export const prerender = true;
export async function getStaticPaths() {
 return (await Promise.all((["en"] as const).map(async (locale) => {
  const posts = await localizedPosts(locale);
  const topics = new Set(posts.flatMap((post) => post.data.tags.map((topic) => topic.toLowerCase())));
  return [...topics].map((slug) => ({params: { slug }, props: {locale, slug}}));
 }))).flat();
}
---
<TagDetail {...Astro.props}  />
