---
import BlogPost from "@/views/BlogPost.astro";
import { localizedPosts, postSlug } from "@/i18n/content";
import { enhanceBlogPosts } from "@/lib/blog-helpers";
export const prerender = true;
export async function getStaticPaths() {
 const allPosts = enhanceBlogPosts(await localizedPosts("en"));
 return allPosts.map((post) => ({ params: { slug: postSlug(post) }, props: { post, allPosts } }));
}
---
<BlogPost {...Astro.props} />
